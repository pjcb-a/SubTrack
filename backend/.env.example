# FOR FLASK SESSION SECURITY
# Generate a new key for production: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# FOR CHOOSING THE DATABASE DURING DEVELOPMENT
# Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/subtrack
# SQLite fallback:
DATABASE_URL=sqlite:///subtrack.db

# FOR ALLOWING THE VUE FRONTEND TO ACCESS THE BACKEND
# Local dev: http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development
FLASK_ENV=development
HOST=127.0.0.1
PORT=5001
